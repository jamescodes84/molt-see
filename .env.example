# Molt-See Vision System Configuration

# ============================================================================
# Molt-Speak Integration
# ============================================================================
MOLT_SPEAK_RUNTIME_DIR=           # Path to molt-speak/runtime/ (auto-detected if adjacent)
ENABLE_SPEAK_INTEGRATION=true     # Enable voice+vision integration

# ============================================================================
# Camera Settings
# ============================================================================
CAMERA_DEVICE_INDEX=0             # Camera device (0 = default webcam)
CAPTURE_FPS=1.0                   # Frames per second (1.0 = once per second)
CAPTURE_RESOLUTION_W=640
CAPTURE_RESOLUTION_H=480

# ============================================================================
# Change Detection
# ============================================================================
CHANGE_SIMILARITY_THRESHOLD=0.92  # SSIM threshold (0-1, higher = less sensitive)
CHANGE_MIN_AREA=0.05              # Minimum changed area fraction (0-1)
CHANGE_METHOD=ssim                # Detection method: ssim, mse, pixel_diff

# ============================================================================
# Scene Analysis
# ============================================================================
ANALYZER_MODE=cascade             # yolo, vlm, cascade, florence, composite
YOLO_MODEL=yolov8n                # YOLO variant: yolov8n, yolov8s, yolov8m
YOLO_CONFIDENCE=0.5               # Minimum detection confidence (0-1)
VLM_PROVIDER=anthropic            # VLM provider: anthropic, openai
VLM_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_API_KEY=                # API key for Claude Vision
VLM_MAX_TOKENS=150                # Max tokens for scene description
FLORENCE_MODEL=microsoft/Florence-2-large  # Florence-2 model (base=fast, large=better)
MOONDREAM_MODEL=vikhyatk/moondream2        # Local VLM for cascade detail stage (free)

# ============================================================================
# Composite Analyzer (YOLO-World + MediaPipe Face)
# ============================================================================
YOLO_WORLD_MODEL=yolov8s-world             # yolov8s-world (fast) or yolov8m-world (accurate)
YOLO_WORLD_CONFIDENCE=0.3                  # Lower than standard YOLO for open-vocab
YOLO_WORLD_CLASSES=person,guitar,piano,microphone,headphones,camera,monitor,keyboard,desk,chair,book,cup,mug,bottle,phone,laptop,cat,dog,backpack,plant,picture frame,clock,lamp,speaker,cable,whiteboard
MEDIAPIPE_FACE_CONFIDENCE=0.5              # Min face detection confidence (0-1)
MEDIAPIPE_MAX_FACES=3                      # Max simultaneous faces to track

# ============================================================================
# Relevance Engine
# ============================================================================
RELEVANCE_THRESHOLD=0.6           # 0.0-1.0 (lower = more observations reported)
OBSERVATION_COOLDOWN=30.0         # Minimum seconds between observations
CONTEXT_WINDOW_LINES=20           # Lines of conversation context to consider

# ============================================================================
# Vision Memory
# ============================================================================
MAX_OBSERVATIONS=100              # Sliding window size for observations
MAX_REPORTED=50                   # Max reported observations to track
MEMORY_SIMILARITY_THRESHOLD=0.85  # Text similarity for deduplication

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=                         # Optional: path to log file (empty = stdout only)

# ============================================================================
# Camera Viewer (PyQt6)
# ============================================================================
VIEWER_FPS=15                     # Viewer camera FPS (default: 15)
VIEWER_CAMERA_DEVICE=0            # Camera device for viewer (default: same as pipeline)
VIEWER_DEFAULT_MODE=compact       # compact or expanded
VIEWER_WINDOW_OPACITY=1.0         # Window opacity (0.0-1.0)
DETECTION_POLL_MS=500             # How often to poll latest_detections.json (ms)
STATUS_POLL_MS=1000               # How often to poll eyes_status.txt (ms)
OBSERVATION_POLL_MS=2000          # How often to poll visual_observations.txt (ms)
DETECTION_STALE_SECONDS=5.0       # Detections older than this show as stale

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_TERMINAL_DISPLAY=true      # Show terminal visualization
DEBUG_MODE=false                  # Extra debug output
